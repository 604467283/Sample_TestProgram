	  <EmbeddedResource Include="ProfileXML\WPA2-PSK.xml" />
	</ItemGroup>

	<ItemGroup>
	  <Reference Include="Ivi.Visa">
	    <HintPath>Library\Ivi.Visa.dll</HintPath>
	  </Reference>
	  <Reference Include="NationalInstruments.Common">
	    <HintPath>Library\NationalInstruments.Common.dll</HintPath>
	  </Reference>
	  <Reference Include="NationalInstruments.Visa">
	    <HintPath>Library\NationalInstruments.Visa.dll</HintPath>
	  </Reference>
	  <Reference Include="SimpleWifi">
	    <HintPath>Utilities\WIFIHelper\Library\SimpleWifi.dll</HintPath>
	  </Reference>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="CaseProject\WCBN816A\" />
	  <Folder Include="CaseProject\新文件夹\" />
	  <Folder Include="Model_Config\OQC\OQC_WCBN814A_S6\" />
	  <Folder Include="Model_Config\OQC\OQC_WCBN811L_L6_LC3\" />
	  <Folder Include="Model_Config\WCBN3602M\WCBN3602M_MB_FT4\" />
	  <Folder Include="Model_Config\WCBN813A\WCBN813A_N5_A_ICT\" />
