	  <Folder Include="Model_Config\ZLogDataCollection\ZLogDataCollection_Litepoint_V2\" />
	  <Folder Include="Model_Config\ZLogDataCollection\ZLogDataCollection_ACE_V1\" />
	  <Folder Include="Model_Config\ZLogDataCollection\ZLogDataCollection_iTest_V1\" />
	  <Folder Include="Model_Config\ZLogDataCollection\ZLogDataCollection_ICT_V1\" />
	  <Folder Include="Model_Config\WCBN3534A\" />
	  <Folder Include="Model_Config\WCBN814A\" />
	  <Folder Include="TestFunc\ACE\LogDataCollection_V1\SampleLog\" />
	  <Folder Include="TestFunc\ICT\LogDataCollection_V1\SampleLog\" />
	  <Folder Include="TestFunc\iTest\LogDataCollection_V1\SampleLog\" />
	  <Folder Include="TestFunc\Litepoint\LogDataCollection_V1\SampleLog\" />
	  <Folder Include="Utilities\WIFIHelper\Library\" />
	</ItemGroup>

	<Target Name="CopyExtraFiles" AfterTargets="Build">
		<ItemGroup>
			<ExtraFiles Include="Library\*.dll" />
		</ItemGroup>
		<Copy SourceFiles="@(ExtraFiles)" DestinationFolder="$(OutputPath)" />
	</Target>

	<Target Name="PreBuild" BeforeTargets="PreBuildEvent">
	  <Exec Command="powershell.exe -ExecutionPolicy Bypass -File &quot;BuildScript\CopyModelConfigFolders.ps1&quot;" />
	</Target>


</Project>